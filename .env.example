# DNS: registro A no AD → ponto.cfo.local (IP deste servidor). Domínio público: ponto.cfo.org.br

# URL pública principal — deve coincidir com o acesso preferido (sem porta na 443).
# IP e ponto.cfo.org.br também funcionam (frontend usa o host atual no OAuth).
# Ex.: https://ponto.cfo.org.br  ou  https://192.168.161.50:12010
PONTO_PUBLIC_DOMAIN=ponto.cfo.org.br
VITE_APP_BASE_URL=https://ponto.cfo.org.br
# Backend: base usada nos links de atalho de e-mails e notificações (mesmo valor do frontend)
APP_BASE_URL=https://ponto.cfo.org.br

DATABASE_URL=postgresql://pontoeletronico:pontoeletronico@localhost:12001/pontoeletronico

# Keycloak — rede interna (IP do servidor SSO)
KEYCLOAK_URL=http://192.168.100.112:8080
KEYCLOAK_ISSUER=http://192.168.100.112:8080/realms/cfo
KEYCLOAK_JWKS_URI=http://192.168.100.112:8080/realms/cfo/protocol/openid-connect/certs
# Necessário no Docker se o certificado do SSO usa CA interna (container não confia por padrão)
KEYCLOAK_JWKS_TLS_INSECURE=true
KEYCLOAK_VALIDATE_ISSUER=false

# API Admin Keycloak — necessário para listar/importar usuários do AD (Gestão de Usuários)
# KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD=sua_senha_admin_keycloak
KEYCLOAK_AUDIENCE=pontoeletronico-dev
KEYCLOAK_CLIENT_SECRET=cDKJYtIN0179FKX4NNkCdDzn6k0lVINp

VITE_KEYCLOAK_URL=https://ponto.cfo.org.br/auth
VITE_KEYCLOAK_REALM=cfo
VITE_KEYCLOAK_CLIENT_ID=pontoeletronico-dev
VITE_SUPER_ADMIN_USERNAMES=elder.oliveira

# Usado apenas em desenvolvimento sem Keycloak (devLogin local)
JWT_SECRET=dev-secret

GLPI_BASE_URL=http://glpi.local
GLPI_API_URL=
VIDEO_CONFERENCE_ENABLED=false

# API de Ramais / Sections (nova integração)
SECTIONS_INTEGRATION_URL=https://192.168.161.50:11010/api/sections/integration/users
SECTIONS_INTEGRATION_TOKEN=seu_token_aqui

# ── Módulo Logs / Observabilidade ──────────────────────────────────────────────

# Super admins (usernames separados por vírgula)
SUPER_ADMIN_USERNAMES=elder.oliveira

# API de Ingestão — chave compartilhada com MonitorSistema (x-ingest-key)
# Mesmo valor em INGEST_SHARED_KEY no Monitor e neste sistema. Não versionar.
INGEST_SHARED_KEY=

# URL de destino do MonitorSistema para envio automático de logs de auditoria
# Ex.: http://localhost:9000/ingest/push-http
# Pode ser substituída pelo painel (instance/monitor_destinations.json)
MONITOR_INGEST_PUSH_URL=

# Desligar envio automático de auditoria ao MonitorSistema (default: true)
MONITOR_AUDIT_INGEST_ENABLED=true

# Metadados enviados nos eventos de ingestão
MONITOR_SERVICE_NAME=api-ponto
MONITOR_ENVIRONMENT=prod

# API de Backup — chave compartilhada com o agente de backup (x-backup-agent-key)
BACKUP_AGENT_SHARED_KEY=

# PostgreSQL: plain = arquivo .sql (psql -f); custom = .bin (pg_restore)
BACKUP_PG_DUMP_FORMAT=plain

# Nome base do backup enviado ao Monitor (vira backup_sst.sql com plain)
BACKUP_ARTIFACT_BASENAME=backup_sst

# Porta do MonitorSistema (referência; o backend Ponto escuta em 3000 — Docker 12003)
MONITOR_PORT=9000

# Caminho onde os artefatos de backup são armazenados
# Docker: use /data/backups com volume; local Windows: caminho absoluto do Monitor
BACKUP_STORAGE_PATH=/data/backups

# Tamanho máximo de upload de artefato (MB)
BACKUP_MAX_UPLOAD_MB=512

# Identificador deste sistema nas APIs públicas
API_PUBLICA_SYSTEM_KEY=ponto-eletronico-cfo

# URL pública da API deste sistema (usada no JSON de polling do MonitorSistema e na aba API Servidora)
PUBLIC_API_BASE_URL=http://192.168.161.50:12003/api

# Webhooks opcionais — notificados automaticamente quando o calendário de feriados é alterado manualmente
# FERIADO_SYNC_WEBHOOK_URLS=https://sistema-externo/api/feriados/webhook
# FERIADO_SYNC_WEBHOOK_KEY=chave-secreta-opcional

# Git — Personal Access Token para push/pull na branch main (scripts/git-push.sh, git-pull.sh)
# Crie em: https://github.com/settings/tokens (escopo repo)
# GITHUB_TOKEN=ghp_...
