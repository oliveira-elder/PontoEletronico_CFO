DATABASE_URL=postgresql://pontoeletronico:pontoeletronico@localhost:12001/pontoeletronico

# Keycloak de produção com AD federado
KEYCLOAK_ISSUER=https://sso.cfo.org.br/realms/pontoeletronico-dev
KEYCLOAK_JWKS_URI=https://sso.cfo.org.br/realms/pontoeletronico-dev/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=pontoeletronico-dev
KEYCLOAK_CLIENT_SECRET=cDKJYtIN0179FKX4NNkCdDzn6k0lVINp

# Usado apenas em desenvolvimento sem Keycloak (devLogin local)
JWT_SECRET=dev-secret

GLPI_BASE_URL=http://glpi.local
GLPI_API_URL=
VIDEO_CONFERENCE_ENABLED=false

# API de Ramais / Sections (nova integração)
SECTIONS_INTEGRATION_URL=https://192.168.100.32:11010/api/sections/integration/users
SECTIONS_INTEGRATION_TOKEN=seu_token_aqui

# ── Módulo Logs / Observabilidade ──────────────────────────────────────────────

# Super admins (usernames separados por vírgula)
SUPER_ADMIN_USERNAMES=elder.oliveira

# API de Ingestão — chave compartilhada com MonitorSistema (x-ingest-key)
# Mesmo valor em INGEST_SHARED_KEY no Monitor e neste sistema. Não versionar.
INGEST_SHARED_KEY=

# URL de destino do MonitorSistema para envio automático de logs de auditoria
# Ex.: http://localhost:9000/ingest/push-http
# Pode ser substituída pelo painel (instance/monitor_destinations.json)
MONITOR_INGEST_PUSH_URL=

# Desligar envio automático de auditoria ao MonitorSistema (default: true)
MONITOR_AUDIT_INGEST_ENABLED=true

# Metadados enviados nos eventos de ingestão
MONITOR_SERVICE_NAME=api-ponto
MONITOR_ENVIRONMENT=prod

# API de Backup — chave compartilhada com o agente de backup (x-backup-agent-key)
BACKUP_AGENT_SHARED_KEY=

# PostgreSQL: plain = arquivo .sql (psql -f); custom = .bin (pg_restore)
BACKUP_PG_DUMP_FORMAT=plain

# Nome base do backup enviado ao Monitor (vira backup_sst.sql com plain)
BACKUP_ARTIFACT_BASENAME=backup_sst

# Porta do MonitorSistema (referência; o backend Ponto escuta em 3000 — Docker 12003)
MONITOR_PORT=9000

# Caminho onde os artefatos de backup são armazenados
# Docker: use /data/backups com volume; local Windows: caminho absoluto do Monitor
BACKUP_STORAGE_PATH=/data/backups

# Tamanho máximo de upload de artefato (MB)
BACKUP_MAX_UPLOAD_MB=512

# Identificador deste sistema nas APIs públicas
API_PUBLICA_SYSTEM_KEY=ponto-eletronico-cfo

# URL pública da API deste sistema (usada no JSON de polling do MonitorSistema)
PUBLIC_API_BASE_URL=http://192.168.100.30:12003/api
