generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublicationStatus {
  DRAFT
  APPROVED
  PUBLISHED
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  emailReal          String?        @unique // e-mail organizacional real (ex: @cfo.org.br), definido pelo RH/admin
  name               String
  externalId         String?        @unique
  memberships        Membership[]
  chatSession        ChatSession[]
  funcionario        Funcionario?
  gerenciasGeridas   Gerencia[]     @relation("GerenciaResponsavel")
  requisicoesCriadas RequisicaoRh[] @relation("RequisicaoRhCriador")
  superAdminConcessao SuperAdminConcessao?
  superAdminConcessoesFeitas SuperAdminConcessao[] @relation("SuperAdminConcessaoPor")
  superAdminRevogacoes       SuperAdminConcessao[] @relation("SuperAdminRevogadoPor")
  sistemaStartsSolicitados   SistemaStartSolicitacao[] @relation("SistemaStartSolicitante")
  createdAt          DateTime       @default(now())
}

model Role {
  id          String       @id @default(cuid())
  code        String       @unique
  memberships Membership[]
}

model Area {
  id             String             @id @default(cuid())
  code           String             @unique
  name           String
  memberships    Membership[]
  moduleConfig   ModuleAreaConfig[]
  chatRules      ChatRule[]
  publicContents PublicContent[]
}

model Membership {
  id     String @id @default(cuid())
  userId String
  roleId String
  areaId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)
}

model Module {
  id        String             @id @default(cuid())
  code      String             @unique
  name      String
  configs   ModuleAreaConfig[]
  createdAt DateTime           @default(now())
}

model ModuleAreaConfig {
  id               String  @id @default(cuid())
  moduleId         String
  areaId           String
  allowPublicIndex Boolean @default(false)
  module           Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  area             Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([moduleId, areaId])
}

model PublicContent {
  id          String            @id @default(cuid())
  areaId      String
  title       String
  body        String
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  area        Area              @relation(fields: [areaId], references: [id], onDelete: Cascade)
}

model Banner {
  id          String  @id @default(cuid())
  title       String
  imageUrl    String
  redirectUrl String?
  active      Boolean @default(true)
}

model ChatIntent {
  id       String     @id @default(cuid())
  code     String     @unique
  patterns String[]
  rules    ChatRule[]
}

model ChatRule {
  id       String     @id @default(cuid())
  areaId   String?
  intentId String
  answer   String
  priority Int        @default(100)
  area     Area?      @relation(fields: [areaId], references: [id], onDelete: SetNull)
  intent   ChatIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  content   String
  sender    String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
}

model GlpiTicketLink {
  id           String   @id @default(cuid())
  userId       String
  glpiTicketId String
  createdAt    DateTime @default(now())
}

model FeatureToggle {
  id      String  @id @default(cuid())
  key     String  @unique
  enabled Boolean @default(false)
}

model MeetingRoom {
  id           String               @id @default(cuid())
  roomCode     String               @unique
  title        String
  participants MeetingParticipant[]
}

model MeetingParticipant {
  id     String      @id @default(cuid())
  roomId String
  userId String
  room   MeetingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model MeetingAudit {
  id        String   @id @default(cuid())
  roomId    String
  action    String
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  tracker     String? // UUID de rastreio por requisição (X-Trace-Id)
  category    String   @default("SUCCESS") // SUCCESS | FAILURE | ERROR
  actorUserId String?
  username    String?
  method      String?
  path        String?
  action      String
  statusCode  Int?
  durationMs  Int?
  ipAddress   String?
  userAgent   String?
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([path])
  @@index([category])
  @@index([tracker])
}

// ════════════════════════════════════════
// MÓDULO LOGS / OBSERVABILIDADE
// ════════════════════════════════════════

model IngestEvent {
  id            String   @id @default(cuid())
  eventId       String   @unique // idempotência: mesmo eventId ignorado
  schemaVersion String   @default("v1")
  timestamp     DateTime
  systemKey     String
  environment   String // dev | homolog | prod
  serviceName   String
  operation     String
  status        String // SUCCESS | FAILURE | ERROR
  severity      String // INFO | WARN | ERROR | CRITICAL
  message       String
  errorCode     String?
  traceId       String?
  correlationId String?
  redirectUrl   String?
  userContext   Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([timestamp])
  @@index([systemKey])
  @@index([status])
  @@index([severity])
}

model BackupJob {
  id            String    @id @default(cuid())
  systemKey     String
  engine        String // postgresql | mysql
  backupMode    String    @default("full") // full | incremental
  config        Json?
  status        String    @default("PENDING") // PENDING | RUNNING | SUCCESS | FAILED
  runToken      String?   @unique // Bearer para upload do artefato
  retentionDays Int       @default(30)
  scheduledAt   DateTime
  startedAt     DateTime?
  completedAt   DateTime?
  lastHeartbeat DateTime?
  artifactPath  String?
  artifactSize  Int? // bytes
  failureMsg    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([systemKey, status])
  @@index([scheduledAt])
}

model ApiToken {
  id          String    @id @default(cuid())
  name        String
  description String?
  tokenHash   String    @unique // SHA-256 do token pleno
  tokenPrefix String // primeiros 8 chars para identificação visual
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

// ════════════════════════════════════════
// GESTÃO DE USUÁRIOS / GRUPOS KEYCLOAK
// ════════════════════════════════════════

model GrupoSistema {
  grupoId   String   @id
  grupoNome String
  papeis    String[] // ex: ["PONTO_ADMIN","GESTOR_APROVACAO","RH_AUDITORIA"]
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ════════════════════════════════════════
// PONTO ELETRÔNICO
// ════════════════════════════════════════

enum TipoPonto {
  ENTRADA
  INICIO_INTERVALO
  FIM_INTERVALO
  SAIDA
  INTERROMPER_EXPEDIENTE
  REINICIAR_EXPEDIENTE
}

enum OrigemPonto {
  WEB
  MOBILE
  DESKTOP
  TOTEM
}

enum StatusPeriodo {
  ABERTO
  FECHADO
  APROVADO
}

enum StatusAssinatura {
  PENDENTE_FUNCIONARIO
  PENDENTE_GESTOR
  CONCLUIDA
  DISPENSADA
}

enum TipoAfastamento {
  FERIAS
  LICENCA_MEDICA
  ATESTADO
  LICENCA_MATERNIDADE
  LICENCA_PATERNIDADE
  FALTA_JUSTIFICADA
  FALTA_INJUSTIFICADA
  ABONO
}

enum StatusSolicitacao {
  PENDENTE // aguardando aprovação do gestor
  AGUARDANDO_RH // gestor aprovou, aguardando aprovação do RH
  AGUARDANDO_DOCUMENTO_FUNCIONARIO // RH enviou guia médica, aguardando retorno do funcionário
  AGUARDANDO_GESTOR_RH // correção criada pelo RH, aguardando aprovação do Gerente de RH (PONTO_ADMIN)
  APROVADA // RH aprovou e mudança foi aplicada
  REJEITADA // legado: rejeitada sem distinção de etapa
  REJEITADA_GESTOR // gestor rejeitou
  REJEITADA_RH // RH rejeitou
  CANCELADA // substituída por uma solicitação de alteração aprovada
}

enum ModoRegistro {
  DESKTOP
  MOBILE
  HIBRIDO
  VIAGEM
  HOME_OFFICE
}

enum TipoFlexibilidade {
  FIXO
  ELASTICO
  BANCO_HORAS
}

enum CategoriaFuncional {
  ESTAGIARIO
  MENOR_APRENDIZ
  CONCURSADO
  ASSESSOR
  GERENTE
}

model BancoHorasMarco {
  id        String   @id @default(cuid())
  data      DateTime @db.Date
  descricao String?
  createdAt DateTime @default(now())

  @@unique([data])
}

model ConfiguracaoSistema {
  id                     String            @id @default("singleton")
  // Instituição
  nome                   String            @default("Conselho Federal de Odontologia")
  cnpj                   String            @default("33.368.957/0001-00")
  endereco               String?
  numero                 String?
  bairro                 String?
  cidade                 String?
  uf                     String?
  cep                    String?
  telefone               String?
  emailInstitucional     String?
  // Geolocalização
  lat                    Float             @default(-15.7876)
  lng                    Float             @default(-47.9040)
  raioMetros             Int               @default(200)
  // Modos de registro
  modoDesktop            Boolean           @default(true)
  modoMobile             Boolean           @default(true)
  modoHibrido            Boolean           @default(false)
  modoViagem             Boolean           @default(false)
  desktopCheckSubrede    Boolean           @default(true)
  desktopCheckGeo        Boolean           @default(false)
  mobileCheckSubrede     Boolean           @default(true)
  mobileCheckGeo         Boolean           @default(true)
  mobileExigirFoto       Boolean           @default(true)
  hibridoExigirFoto      Boolean           @default(true)
  // Jornada padrão
  horaEntrada            String            @default("08:00")
  horaSaida              String            @default("17:00")
  // Janela permitida para bater ponto / solicitar ajuste (horário de Brasília)
  pontoHorarioMinimo     String            @default("06:00")
  pontoHorarioMaximo     String            @default("23:59")
  jornadaDiariaMin       Int               @default(480)
  jornadaSemanalMin      Int               @default(2400)
  diasUteis              String            @default("[false,true,true,true,true,true,false]")
  // Flexibilidade / tolerâncias
  tipoFlexibilidade      TipoFlexibilidade @default(FIXO)
  toleranciaEntradaMin   Int               @default(15)
  toleranciaSaidaMin     Int               @default(15)
  toleranciaHoraExtraMin Int               @default(10)
  toleranciaCalculoMin   Int               @default(5)
  // Intervalo do almoço
  almocoPodeIniciarA     String            @default("11:30")
  almocoPodeIniciarAte   String            @default("13:00")
  almocoMinMin           Int               @default(60)
  almocoMaxMin           Int               @default(90)
  // Modo híbrido
  hibridoMaxDiasSemana   Int               @default(2)
  hibridoExigeAprovacao  Boolean           @default(true)
  // Modo viagem
  viagemJanelaMinutos    Int               @default(120)
  viagemExigeAprovacao   Boolean           @default(true)
  // Banco de horas
  bancoHorasLimiteMin    Int               @default(120)
  bancoHorasVigenciaDias Int               @default(30)
  // Multiplicadores de banco de horas para trabalho em fins de semana/feriados (%)
  bancoHorasSabadoPct    Int               @default(100) // 100% = 1h→1h (banco normal)
  bancoHorasDomingoPct   Int               @default(200) // 200% = 1h→2h (hora em dobro)
  bancoHorasFeriadoPct   Int               @default(200) // 200% = 1h→2h (hora em dobro)
  // Hora extra — limite (em minutos) acima da jornada que dispara solicitação automática
  horaExtraLimiteAuto    Int               @default(120)
  /// 1º dia do mês de go-live (Start do sistema). Null = ainda em fase de teste.
  dataInicioProducao     DateTime?         @db.Date
  updatedAt              DateTime          @updatedAt
  createdAt              DateTime          @default(now())
}

/// Super admin concedido pela UI (além da lista SUPER_ADMIN_USERNAMES no env).
model SuperAdminConcessao {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  concedidoPorUserId String
  concedidoPor     User      @relation("SuperAdminConcessaoPor", fields: [concedidoPorUserId], references: [id])
  ativo            Boolean   @default(true)
  createdAt        DateTime  @default(now())
  revogadoAt       DateTime?
  revogadoPorUserId String?
  revogadoPor      User?     @relation("SuperAdminRevogadoPor", fields: [revogadoPorUserId], references: [id], onDelete: SetNull)
}

enum StatusSistemaStart {
  AGUARDANDO_GERTI
  AGUARDANDO_RH
  REJEITADA_GERTI
  REJEITADA_RH
  EXECUTADO
  CANCELADA
}

/// Solicitação de Start / go-live do sistema (mês de produção).
model SistemaStartSolicitacao {
  id                 String             @id @default(cuid())
  mesReferencia      String // YYYY-MM
  status             StatusSistemaStart @default(AGUARDANDO_GERTI)
  solicitadoPorUserId String
  solicitadoPor      User               @relation("SistemaStartSolicitante", fields: [solicitadoPorUserId], references: [id])
  observacaoSolicitante String?
  aprovadoGertiPorUserId String?
  aprovadoGertiEm    DateTime?
  observacaoGerti    String?
  aprovadoRhPorUserId String?
  aprovadoRhEm       DateTime?
  observacaoRh       String?
  rejeitadoPorUserId String?
  rejeitadoEm        DateTime?
  observacaoRejeicao String?
  executadoEm        DateTime?
  marcoId            String? // BancoHorasMarco.id criado na execução
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Gerencia {
  id                   String                @id @default(cuid())
  nome                 String
  sigla                String                @unique
  responsavel          String?
  responsavelMatricula String?
  responsavelUserId    String? // FK → User.id (gestor responsável)
  responsavelUser      User?                 @relation("GerenciaResponsavel", fields: [responsavelUserId], references: [id], onDelete: SetNull)
  descricao            String?
  ativa                Boolean               @default(true)
  funcionarios         Funcionario[]
  substituicoes        GerenteSubstituicao[]
  createdAt            DateTime              @default(now())
}

/// Passagem de bastão: gerente titular ↔ substituto no período informado.
model GerenteSubstituicao {
  id                          String             @id @default(cuid())
  gerenciaId                  String
  titularId                   String
  substitutoId                String
  dataInicio                  DateTime           @db.Date
  dataFim                     DateTime           @db.Date
  categoriaAnteriorSubstituto CategoriaFuncional
  isManagerAnteriorSubstituto Boolean            @default(false)
  titularAtivoAnterior        Boolean            @default(true)
  /// AGENDADA | ATIVA | ENCERRADA | CANCELADA
  status                      String             @default("AGENDADA")
  appliedAt                   DateTime?
  endedAt                     DateTime?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  gerencia   Gerencia    @relation(fields: [gerenciaId], references: [id], onDelete: Cascade)
  titular    Funcionario @relation("SubstituicaoTitular", fields: [titularId], references: [id], onDelete: Cascade)
  substituto Funcionario @relation("SubstituicaoSubstituto", fields: [substitutoId], references: [id], onDelete: Cascade)

  @@index([status, dataInicio, dataFim])
  @@index([titularId, status])
  @@index([substitutoId, status])
}

model ProvedorInternet {
  id          String   @id @default(cuid())
  nome        String
  ip          String
  isPrincipal Boolean  @default(false)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model SubredeConfigurada {
  id        String   @id @default(cuid())
  cidr      String
  descricao String?
  createdAt DateTime @default(now())
}

model AreaViagem {
  id         String   @id @default(cuid())
  nome       String
  descricao  String?
  lat        Float
  lng        Float
  raioMetros Int      @default(500)
  ativa      Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model RequerimentoEndereco {
  id            String      @id @default(cuid())
  funcionarioId String      @unique
  status        String      @default("PENDENTE") // PENDENTE | RESPONDIDO
  respondidoEm  DateTime?
  criadoEm      DateTime    @default(now())
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
}

model EnderecoResidencial {
  id            String      @id @default(cuid())
  funcionarioId String      @unique
  cep           String?
  logradouro    String?
  numero        String?
  complemento   String?
  bairro        String?
  cidade        String?
  uf            String?
  lat           Float?
  lng           Float?
  raioMetros    Int         @default(20)
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  updatedAt     DateTime    @updatedAt
}

model JornadaPeriodo {
  id                     String            @id @default(cuid())
  nome                   String
  descricao              String?
  ePadrao                Boolean           @default(false)
  ativo                  Boolean           @default(true)
  horaEntrada            String            @default("08:00")
  horaSaida              String            @default("17:00")
  jornadaDiariaMin       Int               @default(480)
  jornadaSemanalMin      Int               @default(2400)
  diasUteis              String            @default("[false,true,true,true,true,true,false]")
  tipoFlexibilidade      TipoFlexibilidade @default(FIXO)
  toleranciaEntradaMin   Int               @default(15)
  toleranciaSaidaMin     Int               @default(15)
  toleranciaHoraExtraMin Int               @default(10)
  toleranciaCalculoMin   Int               @default(5)
  almocoPodeIniciarA     String            @default("11:30")
  almocoPodeIniciarAte   String            @default("13:00")
  almocoMinMin           Int               @default(60)
  almocoMaxMin           Int               @default(90)
  bancoHorasLimiteMin    Int               @default(120)
  bancoHorasVigenciaDias Int               @default(30)
  horaExtraLimiteAuto    Int               @default(120)
  funcionarios           Funcionario[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model Funcionario {
  id                        String                     @id @default(cuid())
  userId                    String                     @unique
  matricula                 String?                    @unique // nullable: usuários AD sincronizados podem não ter matrícula
  cpf                       String?
  cargo                     String                     @default("")
  departamento              String?
  gerenciaId                String?
  jornadaPeriodoId          String?
  jornadaPeriodoDesde       DateTime?                  @db.Date
  jornadaPeriodoAssociadoEm DateTime?
  modoHomeOffice            Boolean                    @default(false)
  modoHibridoLocal          Boolean                    @default(false)
  categoria                 CategoriaFuncional         @default(CONCURSADO)
  /// A partir desta data o funcionário passa a ter obrigação de ponto (ex.: assessor → concursado).
  /// Dias anteriores e efeitos de solicitações informativas não entram no cálculo.
  pontoObrigatorioDesde     DateTime?                  @db.Date
  ativo                     Boolean                    @default(true)
  jornadaHorasDia           Int                        @default(8)
  extensionsId              String?                    @unique // id na API externa de ramais
  section                   String? // seção (slug) na API externa
  subsecao                  String? // subseção (slug), quando aplicável
  isManager                 Boolean                    @default(false) // gerente da seção
  /// Supervisor de estágio (ESTAGIARIO / MENOR_APRENDIZ) — aprova solicitações no lugar do gerente
  supervisorEstagioId       String?
  supervisorEstagio         Funcionario?               @relation("SupervisorEstagio", fields: [supervisorEstagioId], references: [id], onDelete: SetNull)
  supervisionadosEstagio    Funcionario[]              @relation("SupervisorEstagio")
  ramal                     String? // ramal telefônico
  sala                      String? // sala/room
  andar                     String? // andar/floor
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  gerencia                  Gerencia?                  @relation(fields: [gerenciaId], references: [id], onDelete: SetNull)
  jornadaPeriodo            JornadaPeriodo?            @relation(fields: [jornadaPeriodoId], references: [id], onDelete: SetNull)
  registros                 RegistroPonto[]
  periodos                  PeriodoPonto[]
  afastamentos              Afastamento[]
  solicitacoes              Solicitacao[]
  documentosRh              DocumentoRhEnvio[]
  requisicoes               RequisicaoRhDestinatario[]
  jornadas                  JornadaTrabalho[]
  enderecoResidencial       EnderecoResidencial?
  requerimentoEndereco      RequerimentoEndereco?
  fotoPerfilUrl             String?
  solicitarAtualizacaoFoto  Boolean                    @default(false)
  dataNascimento            DateTime?                  @db.Date
  dataAdmissao              DateTime?                  @db.Date
  createdAt                 DateTime                   @default(now())
  substituicoesComoTitular  GerenteSubstituicao[]      @relation("SubstituicaoTitular")
  substituicoesComoSubstituto GerenteSubstituicao[]    @relation("SubstituicaoSubstituto")
  categoriasHistorico       FuncionarioCategoriaHistorico[]
}

/// Vigência de categoria funcional — base para isentar períodos sem obrigação de ponto
/// (ex.: concursado → assessor → concursado: só os trechos como concursado entram no cálculo).
model FuncionarioCategoriaHistorico {
  id             String             @id @default(cuid())
  funcionarioId  String
  categoria      CategoriaFuncional
  vigenciaDesde  DateTime           @db.Date
  /// null = vigência atual (aberta)
  vigenciaAte    DateTime?          @db.Date
  funcionario    Funcionario        @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())

  @@index([funcionarioId, vigenciaDesde])
}

model JornadaTrabalho {
  id               String      @id @default(cuid())
  funcionarioId    String
  diaSemana        Int // 0=Dom, 1=Seg ... 6=Sáb
  horaEntrada      String // "08:00"
  horaSaida        String // "17:00"
  horaInicioInterv String // "12:00"
  horaFimInterv    String // "13:00"
  funcionario      Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, diaSemana])
}

model RegistroPonto {
  id              String       @id @default(cuid())
  funcionarioId   String
  tipo            TipoPonto
  dataHora        DateTime
  latitude        Float?
  longitude       Float?
  origem          OrigemPonto  @default(WEB)
  modoRegistro    ModoRegistro @default(DESKTOP)
  ipOrigem        String?
  fotoUrl         String?
  dentroPerimetro Boolean      @default(false)
  observacao      String?
  observacoes     Json         @default("[]")
  ajustado        Boolean      @default(false)
  ajustadoPor     String?
  /// Gerado por solicitação de assessor/gerente — aparece no histórico, não entra em cálculo.
  apenasInformativo Boolean    @default(false)
  funcionario     Funcionario  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@index([funcionarioId, dataHora])
}

model PeriodoPonto {
  id                      String            @id @default(cuid())
  funcionarioId           String
  mes                     Int // 1–12
  ano                     Int
  horasTrabalhadasMinutos Int               @default(0)
  horasExtrasMinutos      Int               @default(0)
  horasFaltaMinutos       Int               @default(0)
  diasTrabalhados         Int               @default(0)
  status                  StatusPeriodo     @default(ABERTO)
  fechadoEm               DateTime?
  aprovadoPor             String?
  funcionario             Funcionario       @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  assinatura              AssinaturaQuadro?

  @@unique([funcionarioId, mes, ano])
}

model AssinaturaQuadro {
  id                           String           @id @default(cuid())
  periodoId                    String           @unique
  periodo                      PeriodoPonto     @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  status                       StatusAssinatura @default(PENDENTE_FUNCIONARIO)
  bancoHorasSaldoTotalMinutos  Int              @default(0)
  // Assinatura do funcionário
  assinadoFuncionarioEm        DateTime?
  assinadoFuncionarioIp        String? // IP real do PC (primeiro salto do X-Forwarded-For)
  assinadoFuncionarioIpGateway String? // IP da gateway de borda (peer imediato / último proxy)
  assinadoFuncionarioUserAgent String?
  assinadoFuncionarioUserId    String?
  // Assinatura do gestor
  assinadoGestorEm             DateTime?
  assinadoGestorIp             String? // IP real do PC (primeiro salto do X-Forwarded-For)
  assinadoGestorIpGateway      String? // IP da gateway de borda (peer imediato / último proxy)
  assinadoGestorUserAgent      String?
  assinadoGestorUserId         String?
  assinadoGestorNome           String?
  criadoEm                     DateTime         @default(now())
  criadoPor                    String           @default("SISTEMA")

  @@index([status])
}

model Afastamento {
  id            String          @id @default(cuid())
  funcionarioId String
  tipo          TipoAfastamento
  dataInicio    DateTime
  dataFim       DateTime
  /// HH:MM — presente junto com horarioFim = atestado/afastamento parcial (não dia inteiro)
  horarioInicio String?
  /// HH:MM — presente junto com horarioInicio = afastamento parcial
  horarioFim    String?
  justificativa String?
  documentoUrl  String?
  aprovadoPor   String?
  /// Gerado por solicitação de assessor/gerente — aparece no histórico, não entra em cálculo.
  apenasInformativo Boolean     @default(false)
  funcionario   Funcionario     @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
}

model Solicitacao {
  id                   String            @id @default(cuid())
  funcionarioId        String
  tipo                 String // CORRECAO_PONTO | ATESTADO | FERIAS | LICENCA | ABONO | DAY_OFF | HORA_EXTRA | ENVIO_DOCUMENTO_RH
  dataReferencia       DateTime
  dataInicio           DateTime? // data inicial (ATESTADO, FERIAS, LICENCA, ABONO)
  dataFim              DateTime? // data final do intervalo
  descricao            String
  metadados            Json? // dados específicos por tipo (vide plano)
  status               StatusSolicitacao @default(PENDENTE)
  /// Assessor/Gerente: após aprovação, histórico é só informativo (não base de cálculo).
  apenasInformativo    Boolean           @default(false)
  // Etapa 1 — Gestor
  gestorUserId         String? // User.id do gestor que resolveu
  gestorObservacao     String?
  gestorResolvidoEm    DateTime?
  // Etapa 2 — RH
  rhUserId             String? // User.id do analista de RH que resolveu
  rhObservacao         String?
  rhResolvidoEm        DateTime?
  // Guia médica individual (ATESTADO com homologação) — enviada pelo RH ao funcionário
  guiaMedicoUrl        String?
  guiaMedicoEnviadaEm  DateTime?
  guiaMedicoObservacao String?
  // Documento de retorno da consulta (aptidão/inaptidão) — enviado pelo funcionário
  documentoRetornoUrl  String?
  documentoRetornoEm   DateTime?
  // Campos legados mantidos para compatibilidade
  observacaoGestor     String?
  resolvidoPor         String? // Keycloak sub (aponta para RH no novo fluxo)
  resolvidoEm          DateTime?
  funcionario          Funcionario       @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  createdAt            DateTime          @default(now())
}

model DocumentoRhEnvio {
  id            String      @id @default(cuid())
  funcionarioId String
  descricao     String
  arquivoUrl    String
  nomeArquivo   String?
  mimeType      String?
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([funcionarioId, createdAt])
}

model ConfiguracaoSolicitacoes {
  id                          String   @id @default("singleton")
  // Regras de Atestado
  atestadoDiasLimiteSimples   Int      @default(3)
  atestadoDiasLimiteInss      Int      @default(14)
  atestadoPrazoEnvioDias      Int      @default(2)
  atestadoMensagemOriginais   String   @default("Os originais devem ser entregues ao setor de RH.")
  // Regras de Férias
  feriasAntecedenciaMinDias   Int      @default(30)
  feriasMinimoGrandePeriodo   Int      @default(14)
  feriasMinimoOutrosPeriodos  Int      @default(5)
  feriasMaxPeriodos           Int      @default(3)
  feriasMaxDiasVenda          Int      @default(10)
  feriasVedacaoPreFeriadoDias Int      @default(2)
  // Tipos de solicitação ativos no portal do funcionário
  tipoAtivoCorrecaoPonto      Boolean  @default(true)
  tipoAtivoAtestado           Boolean  @default(true)
  tipoAtivoFerias             Boolean  @default(true)
  tipoAtivoLicenca            Boolean  @default(true)
  tipoAtivoAbono              Boolean  @default(true)
  tipoAtivoDayOff             Boolean  @default(true)
  tipoAtivoHoraExtra          Boolean  @default(true)
  tipoAtivoEnvioDocumentoRh   Boolean  @default(true)
  updatedAt                   DateTime @updatedAt
  createdAt                   DateTime @default(now())
}

model FeriadoConfig {
  id               String   @id @default(cuid())
  data             DateTime @db.Date
  nome             String
  tipo             String // "NACIONAL" | "DISTRITAL" | "FACULTATIVO" | "MANUAL"
  bloqueiaRegistro Boolean  @default(true)
  origem           String // "API" | "MANUAL"
  observacao       String?
  marcoHorario     String? // "HH:MM" — ausente = dia todo
  marcoLado        String? // "ANTES" | "DEPOIS"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([data])
}

model SyncLog {
  id        String   @id @default(cuid())
  source    String // "extensions"
  status    String // "success" | "error"
  created   Int      @default(0)
  updated   Int      @default(0)
  skipped   Int      @default(0)
  errors    Int      @default(0)
  details   Json?
  createdAt DateTime @default(now())
}

// Configuração SMTP — singleton, acesso restrito a super admin
model ConfiguracaoEmail {
  id             String   @id @default("singleton")
  provedor       String   @default("LOCAWEB") // "LOCAWEB" | "MICROSOFT"
  host           String?
  porta          Int?     @default(587)
  seguranca      String   @default("STARTTLS") // "NONE" | "SSL" | "STARTTLS"
  usuario        String?
  senha          String?
  nomeRemetente  String?
  emailRemetente String?
  ativo          Boolean  @default(false)
  atualizadoEm   DateTime @updatedAt
  criadoEm       DateTime @default(now())
}

// Configuração de notificação por evento — uma linha por gatilho
model ConfiguracaoNotificacao {
  id           String   @id // ex: "ASSINAR_QUADRO", "FERIAS_OBRIGATORIO"
  ativoEmail   Boolean  @default(false)
  ativoSistema Boolean  @default(false)
  atualizadoEm DateTime @updatedAt
  criadoEm     DateTime @default(now())
}

enum TipoRequisicaoRh {
  PERIODICO
  EXAME_MEDICO
  FERIAS
  ASSINATURA_DOCUMENTOS
  OUTRO
}

enum StatusRequisicaoDestinatario {
  PENDENTE
  VISUALIZADO
  RESPONDIDO
}

model RequisicaoRh {
  id            String                     @id @default(cuid())
  tipo          TipoRequisicaoRh
  titulo        String
  descricao     String?
  arquivoUrl    String?
  prazo         DateTime?
  ativa         Boolean                    @default(true)
  criadoPorId   String
  criadoPor     User                       @relation("RequisicaoRhCriador", fields: [criadoPorId], references: [id])
  destinatarios RequisicaoRhDestinatario[]
  criadaEm      DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
}

model RequisicaoRhDestinatario {
  id                   String                       @id @default(cuid())
  requisicaoId         String
  funcionarioId        String
  requisicao           RequisicaoRh                 @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  funcionario          Funcionario                  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  status               StatusRequisicaoDestinatario @default(PENDENTE)
  visualizadaEm        DateTime?
  respondidaEm         DateTime?
  respostaTexto        String?
  respostaArquivoUrl   String?
  arquivoIndividualUrl String?
  createdAt            DateTime                     @default(now())

  @@unique([requisicaoId, funcionarioId])
}

// Notificações individuais por usuário (bell icon / página de notificações)
model Notificacao {
  id             String   @id @default(cuid())
  userExternalId String // Keycloak sub = User.externalId
  titulo         String
  corpo          String?
  tipo           String? // event id: "ASSINAR_QUADRO", "FERIAS_OBRIGATORIO" etc.
  lida           Boolean  @default(false)
  criadoEm       DateTime @default(now())

  @@index([userExternalId, lida])
  @@index([userExternalId, criadoEm(sort: Desc)])
}
