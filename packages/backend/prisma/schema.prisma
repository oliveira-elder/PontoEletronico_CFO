generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublicationStatus {
  DRAFT
  APPROVED
  PUBLISHED
}

model User {
  id                         String                    @id @default(cuid())
  email                      String                    @unique
  emailReal                  String?                   @unique // e-mail organizacional real (ex: @cfo.org.br), definido pelo RH/admin
  name                       String
  externalId                 String?                   @unique
  /// Data/hora do último login (última chamada de /auth/me) — usado para indicar
  /// na Gestão se o funcionário já fez login hoje.
  ultimoLoginEm              DateTime?
  /// Data/hora do PRIMEIRO login real (gravada uma única vez, nunca sobrescrita).
  /// É o marco de "início de atividades" do funcionário — dias anteriores a ela não
  /// contam falta nem saldo negativo no histórico/banco de horas/auditoria, pois o
  /// funcionário pode ter sido cadastrado pelo RH bem antes do seu primeiro acesso.
  primeiroLoginEm            DateTime?
  memberships                Membership[]
  chatSession                ChatSession[]
  funcionario                Funcionario?
  gerenciasGeridas           Gerencia[]                @relation("GerenciaResponsavel")
  requisicoesCriadas         RequisicaoRh[]            @relation("RequisicaoRhCriador")
  superAdminConcessao        SuperAdminConcessao?
  superAdminConcessoesFeitas SuperAdminConcessao[]     @relation("SuperAdminConcessaoPor")
  superAdminRevogacoes       SuperAdminConcessao[]     @relation("SuperAdminRevogadoPor")
  sistemaStartsSolicitados   SistemaStartSolicitacao[] @relation("SistemaStartSolicitante")
  createdAt                  DateTime                  @default(now())

  /// Índices trigram (pg_trgm) — aceleram a busca por pessoa (nome/e-mail) nas
  /// telas de Logs (ex.: "registro de fulano").
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_name_trgm_idx")
  @@index([emailReal(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_emailReal_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_email_trgm_idx")
}

model Role {
  id          String       @id @default(cuid())
  code        String       @unique
  memberships Membership[]
}

model Area {
  id             String             @id @default(cuid())
  code           String             @unique
  name           String
  memberships    Membership[]
  moduleConfig   ModuleAreaConfig[]
  chatRules      ChatRule[]
  publicContents PublicContent[]
}

model Membership {
  id     String @id @default(cuid())
  userId String
  roleId String
  areaId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)
}

model Module {
  id        String             @id @default(cuid())
  code      String             @unique
  name      String
  configs   ModuleAreaConfig[]
  createdAt DateTime           @default(now())
}

model ModuleAreaConfig {
  id               String  @id @default(cuid())
  moduleId         String
  areaId           String
  allowPublicIndex Boolean @default(false)
  module           Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  area             Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([moduleId, areaId])
}

model PublicContent {
  id          String            @id @default(cuid())
  areaId      String
  title       String
  body        String
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  area        Area              @relation(fields: [areaId], references: [id], onDelete: Cascade)
}

model Banner {
  id          String  @id @default(cuid())
  title       String
  imageUrl    String
  redirectUrl String?
  active      Boolean @default(true)
}

model ChatIntent {
  id       String     @id @default(cuid())
  code     String     @unique
  patterns String[]
  rules    ChatRule[]
}

model ChatRule {
  id       String     @id @default(cuid())
  areaId   String?
  intentId String
  answer   String
  priority Int        @default(100)
  area     Area?      @relation(fields: [areaId], references: [id], onDelete: SetNull)
  intent   ChatIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  content   String
  sender    String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
}

model GlpiTicketLink {
  id           String   @id @default(cuid())
  userId       String
  glpiTicketId String
  createdAt    DateTime @default(now())
}

model FeatureToggle {
  id      String  @id @default(cuid())
  key     String  @unique
  enabled Boolean @default(false)
}

model MeetingRoom {
  id           String               @id @default(cuid())
  roomCode     String               @unique
  title        String
  participants MeetingParticipant[]
}

model MeetingParticipant {
  id     String      @id @default(cuid())
  roomId String
  userId String
  room   MeetingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model MeetingAudit {
  id        String   @id @default(cuid())
  roomId    String
  action    String
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  tracker     String? // UUID de rastreio por requisição (X-Trace-Id)
  category    String   @default("SUCCESS") // SUCCESS | FAILURE | ERROR
  actorUserId String?
  username    String?
  method      String?
  path        String?
  action      String
  statusCode  Int?
  durationMs  Int?
  ipAddress   String?
  userAgent   String?
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([path])
  @@index([category])
  @@index([tracker])
  /// Índices trigram (pg_trgm) — aceleram buscas por substring (contains/ILIKE '%...%')
  /// usadas na busca por assunto/pessoa das telas de Logs. Sem isso, cada busca faz
  /// varredura sequencial na tabela inteira (só de AuditLog já são ~160 mil linhas).
  @@index([path(ops: raw("gin_trgm_ops"))], type: Gin, map: "AuditLog_path_trgm_idx")
  @@index([action(ops: raw("gin_trgm_ops"))], type: Gin, map: "AuditLog_action_trgm_idx")
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "AuditLog_username_trgm_idx")
}

// ════════════════════════════════════════
// MÓDULO LOGS / OBSERVABILIDADE
// ════════════════════════════════════════

model IngestEvent {
  id            String   @id @default(cuid())
  eventId       String   @unique // idempotência: mesmo eventId ignorado
  schemaVersion String   @default("v1")
  timestamp     DateTime
  systemKey     String
  environment   String // dev | homolog | prod
  serviceName   String
  operation     String
  status        String // SUCCESS | FAILURE | ERROR
  severity      String // INFO | WARN | ERROR | CRITICAL
  message       String
  errorCode     String?
  traceId       String?
  correlationId String?
  redirectUrl   String?
  userContext   Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([timestamp])
  @@index([systemKey])
  @@index([status])
  @@index([severity])
}

model BackupJob {
  id            String    @id @default(cuid())
  systemKey     String
  engine        String // postgresql | mysql
  backupMode    String    @default("full") // full | incremental
  config        Json?
  status        String    @default("PENDING") // PENDING | RUNNING | SUCCESS | FAILED
  runToken      String?   @unique // Bearer para upload do artefato
  retentionDays Int       @default(30)
  scheduledAt   DateTime
  startedAt     DateTime?
  completedAt   DateTime?
  lastHeartbeat DateTime?
  artifactPath  String?
  artifactSize  Int? // bytes
  failureMsg    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([systemKey, status])
  @@index([scheduledAt])
}

model ApiToken {
  id          String    @id @default(cuid())
  name        String
  description String?
  tokenHash   String    @unique // SHA-256 do token pleno
  tokenPrefix String // primeiros 8 chars para identificação visual
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

// ════════════════════════════════════════
// GESTÃO DE USUÁRIOS / GRUPOS KEYCLOAK
// ════════════════════════════════════════

model GrupoSistema {
  grupoId   String   @id
  grupoNome String
  papeis    String[] // ex: ["PONTO_ADMIN","GESTOR_APROVACAO","RH_AUDITORIA"]
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ════════════════════════════════════════
// PONTO ELETRÔNICO
// ════════════════════════════════════════

enum TipoPonto {
  ENTRADA
  INICIO_INTERVALO
  FIM_INTERVALO
  SAIDA
  INTERROMPER_EXPEDIENTE
  REINICIAR_EXPEDIENTE
}

enum OrigemPonto {
  WEB
  MOBILE
  DESKTOP
  TOTEM
}

enum StatusPeriodo {
  ABERTO
  FECHADO
  APROVADO
}

enum StatusAssinatura {
  PENDENTE_FUNCIONARIO
  PENDENTE_GESTOR
  CONCLUIDA
  DISPENSADA
}

enum TipoAfastamento {
  FERIAS
  LICENCA_MEDICA
  ATESTADO
  LICENCA_MATERNIDADE
  LICENCA_PATERNIDADE
  FALTA_JUSTIFICADA
  FALTA_INJUSTIFICADA
  ABONO
}

enum StatusSolicitacao {
  PENDENTE // aguardando aprovação do gestor
  AGUARDANDO_RH // gestor aprovou, aguardando aprovação do RH
  AGUARDANDO_DOCUMENTO_FUNCIONARIO // RH enviou guia médica, aguardando retorno do funcionário
  AGUARDANDO_GESTOR_RH // correção criada pelo RH, aguardando aprovação do Gerente de RH (PONTO_ADMIN)
  APROVADA // RH aprovou e mudança foi aplicada
  REJEITADA // legado: rejeitada sem distinção de etapa
  REJEITADA_GESTOR // gestor rejeitou
  REJEITADA_RH // RH rejeitou
  CANCELADA // substituída por uma solicitação de alteração aprovada
}

enum ModoRegistro {
  DESKTOP
  MOBILE
  HIBRIDO
  VIAGEM
  HOME_OFFICE
}

enum TipoFlexibilidade {
  FIXO
  ELASTICO
  BANCO_HORAS
}

/// Nível do cargo do empregado (concursado).
enum NivelCargo {
  MEDIO
  SUPERIOR
  TECNICO
}

enum CategoriaFuncional {
  ESTAGIARIO
  MENOR_APRENDIZ
  CONCURSADO
  ASSESSOR
}

/// Atividade-meio (suporte/administrativa) x atividade-fim (finalística do órgão).
enum AtividadeTipo {
  MEIO
  FIM
}

model BancoHorasMarco {
  id        String   @id @default(cuid())
  /// Dia do mês (1–31). Em meses curtos, aplica-se o último dia válido.
  dia       Int
  /// Mês (1–12).
  mes       Int
  /// null = recorrente todo ano; preenchido = ocorrência única naquele ano (ex.: start).
  ano       Int?
  /// Chave estável: "A-MM-DD" (anual) ou "U-YYYY-MM-DD" (única).
  chave     String   @unique
  descricao String?
  createdAt DateTime @default(now())

  @@index([mes, dia])
}

/// Tempo do banco de horas liberado pelo RH para o funcionário usar via Abono (crédito com validade;
/// debita o saldo do banco na data da liberação e sobrevive à zeragem do ciclo).
model BancoHorasLiberacao {
  id                     String      @id @default(cuid())
  funcionarioId          String
  minutos                Int
  /// Último dia (Brasília) em que o abono com este crédito pode ser tirado.
  validaAte              DateTime    @db.Date
  justificativa          String
  liberadoPorNome        String
  liberadoPorUserId      String?
  /// Início do ciclo do banco em que o saldo foi debitado (YYYY-MM-DD).
  cicloInicio            String?
  /// Minutos revogados pelo RH (parte não usada no momento da revogação).
  minutosRevogados       Int         @default(0)
  /// Minutos devolvidos ao banco na revogação (só se o ciclo ainda é o mesmo).
  devolvidoAoBancoMin    Int         @default(0)
  revogadaEm             DateTime?
  revogadaPorNome        String?
  revogacaoJustificativa String?
  /// Aviso de vencimento já enviado.
  avisoVencimentoEm      DateTime?
  createdAt              DateTime    @default(now())
  funcionario            Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId, validaAte])
}

model ConfiguracaoSistema {
  id                                 String            @id @default("singleton")
  // Instituição
  nome                               String            @default("Conselho Federal de Odontologia")
  cnpj                               String            @default("33.368.957/0001-00")
  endereco                           String?
  numero                             String?
  bairro                             String?
  cidade                             String?
  uf                                 String?
  cep                                String?
  telefone                           String?
  emailInstitucional                 String?
  // REP / PTRP — Portaria MTP 671/2021 (AFD e AEJ)
  repInpiRegistro                    String?
  repCnoCaepf                        String?
  repLocalPrestacao                  String?
  repResponsavelCpf                  String?
  ptrpNome                           String            @default("Sistema de Ponto Eletrônico CFO")
  ptrpVersao                         String            @default("1.0")
  ptrpDesenvolvedorCnpj              String?
  ptrpDesenvolvedorRazao             String?
  ptrpDesenvolvedorEmail             String?
  // Geolocalização
  lat                                Float             @default(-15.7876)
  lng                                Float             @default(-47.9040)
  raioMetros                         Int               @default(200)
  // Modos de registro
  modoDesktop                        Boolean           @default(true)
  modoMobile                         Boolean           @default(true)
  modoHibrido                        Boolean           @default(false)
  modoViagem                         Boolean           @default(false)
  desktopCheckSubrede                Boolean           @default(true)
  desktopCheckGeo                    Boolean           @default(false)
  mobileCheckSubrede                 Boolean           @default(true)
  mobileCheckGeo                     Boolean           @default(true)
  mobileExigirFoto                   Boolean           @default(true)
  hibridoExigirFoto                  Boolean           @default(true)
  // Jornada padrão
  horaEntrada                        String            @default("08:00")
  horaSaida                          String            @default("17:00")
  // Janela permitida para bater ponto / solicitar ajuste (horário de Brasília)
  pontoHorarioMinimo                 String            @default("06:00")
  pontoHorarioMaximo                 String            @default("23:59")
  jornadaDiariaMin                   Int               @default(480)
  jornadaSemanalMin                  Int               @default(2400)
  diasUteis                          String            @default("[false,true,true,true,true,true,false]")
  // Flexibilidade / tolerâncias
  tipoFlexibilidade                  TipoFlexibilidade @default(FIXO)
  toleranciaEntradaMin               Int               @default(5)
  toleranciaSaidaMin                 Int               @default(5)
  toleranciaHoraExtraMin             Int               @default(10)
  toleranciaCalculoMin               Int               @default(0)
  // Intervalo do almoço
  almocoPodeIniciarA                 String            @default("11:30")
  almocoPodeIniciarAte               String            @default("13:00")
  almocoMinMin                       Int               @default(60)
  almocoMaxMin                       Int               @default(90)
  // Modo híbrido
  hibridoMaxDiasSemana               Int               @default(2)
  hibridoExigeAprovacao              Boolean           @default(true)
  // Modo viagem
  viagemJanelaMinutos                Int               @default(120)
  viagemExigeAprovacao               Boolean           @default(true)
  // Banco de horas
  bancoHorasLimiteMin                Int               @default(120)
  bancoHorasVigenciaDias             Int               @default(30)
  /// Tolerância (dias) do fechamento do banco: a zeragem ocorre N dias após a data-marco (global; individual sobrepõe).
  bancoHorasToleranciaFechamentoDias Int               @default(0)
  /// Exame médico ocupacional periódico: periodicidade (meses) e antecedência do aviso (dias).
  exameOcupacionalPeriodicidadeMeses Int               @default(12)
  exameOcupacionalAvisoDias          Int               @default(30)

  /// Validade sugerida (dias) do tempo de banco liberado pelo RH para abono.
  bancoHorasLiberacaoValidadeDias Int       @default(180)
  // Multiplicadores de banco de horas para trabalho em fins de semana/feriados (%)
  bancoHorasSabadoPct             Int       @default(100) // 100% = 1h→1h (banco normal)
  bancoHorasDomingoPct            Int       @default(200) // 200% = 1h→2h (hora em dobro)
  bancoHorasFeriadoPct            Int       @default(200) // 200% = 1h→2h (hora em dobro)
  /// Antecedência (dias) para alertar o fim do contrato de Estagiário/Jovem Aprendiz.
  /// Acordo coletivo que reduz a jornada (exibido no Espelho: "8h00/dia – ACT 2026-2028: 7h00/dia").
  jornadaAcordoColetivo           String?   @default("ACT 2026-2028")
  contratoAvisoAntecedenciaDias   Int       @default(90)
  // Hora extra — limite (em minutos) acima da jornada que dispara solicitação automática
  horaExtraLimiteAuto             Int       @default(120)
  /// Descanso mínimo de interjornada (min) entre a última saída e a próxima entrada. 660 = 11h (CLT art. 66); 0 = desativado.
  interjornadaMin                 Int       @default(660)
  /// Dias em casa (home office/híbrido) só são "OK" com o ciclo completo de batidas, a partir desta data (civil, Brasília). Nulo = desligado.
  cicloCompletoEmCasaDesde        DateTime? @db.Date
  /// Ponto presencial: dia só "OK" com o ciclo de batidas que a lei exige para a jornada do dia, a partir desta data. Nulo = desligado.
  cicloCompletoPresencialDesde    DateTime? @db.Date
  /// Jornada acima disso (min) exige o intervalo de almoço (CLT art. 71: 6 h). Tempo mínimo = almocoMinMin.
  intervaloLongoAcimaDeMin        Int       @default(360)
  /// Jornada acima disso (min), até o limite longo, exige intervalo curto (CLT art. 71: 4 h).
  intervaloCurtoAcimaDeMin        Int       @default(240)
  /// Tempo mínimo (min) do intervalo curto (CLT art. 71: 15 min).
  intervaloCurtoMinMin            Int       @default(15)
  /// 1º dia do mês de go-live (Start do sistema). Null = ainda em fase de teste.
  dataInicioProducao              DateTime? @db.Date
  updatedAt                       DateTime  @updatedAt
  createdAt                       DateTime  @default(now())
}

/// Super admin concedido pela UI (além da lista SUPER_ADMIN_USERNAMES no env).
model SuperAdminConcessao {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  concedidoPorUserId String
  concedidoPor       User      @relation("SuperAdminConcessaoPor", fields: [concedidoPorUserId], references: [id])
  ativo              Boolean   @default(true)
  createdAt          DateTime  @default(now())
  revogadoAt         DateTime?
  revogadoPorUserId  String?
  revogadoPor        User?     @relation("SuperAdminRevogadoPor", fields: [revogadoPorUserId], references: [id], onDelete: SetNull)
}

enum StatusSistemaStart {
  AGUARDANDO_GERTI
  AGUARDANDO_RH
  REJEITADA_GERTI
  REJEITADA_RH
  EXECUTADO
  CANCELADA
}

/// Solicitação de Start / go-live do sistema (mês de produção).
model SistemaStartSolicitacao {
  id                     String             @id @default(cuid())
  mesReferencia          String // YYYY-MM
  status                 StatusSistemaStart @default(AGUARDANDO_GERTI)
  solicitadoPorUserId    String
  solicitadoPor          User               @relation("SistemaStartSolicitante", fields: [solicitadoPorUserId], references: [id])
  observacaoSolicitante  String?
  aprovadoGertiPorUserId String?
  aprovadoGertiEm        DateTime?
  observacaoGerti        String?
  aprovadoRhPorUserId    String?
  aprovadoRhEm           DateTime?
  observacaoRh           String?
  rejeitadoPorUserId     String?
  rejeitadoEm            DateTime?
  observacaoRejeicao     String?
  executadoEm            DateTime?
  marcoId                String? // BancoHorasMarco.id criado na execução
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Gerencia {
  id                   String                        @id @default(cuid())
  nome                 String
  sigla                String                        @unique
  responsavel          String?
  responsavelMatricula String?
  responsavelUserId    String? // FK → User.id (gestor responsável)
  responsavelUser      User?                         @relation("GerenciaResponsavel", fields: [responsavelUserId], references: [id], onDelete: SetNull)
  descricao            String?
  ativa                Boolean                       @default(true)
  funcionarios         Funcionario[]
  substituicoes        GerenteSubstituicao[]
  lotacaoHistorico     FuncionarioLotacaoHistorico[]
  createdAt            DateTime                      @default(now())
}

/// Passagem de bastão: gerente titular ↔ substituto no período informado.
model GerenteSubstituicao {
  id                          String             @id @default(cuid())
  gerenciaId                  String
  titularId                   String
  substitutoId                String
  dataInicio                  DateTime           @db.Date
  dataFim                     DateTime           @db.Date
  categoriaAnteriorSubstituto CategoriaFuncional
  isManagerAnteriorSubstituto Boolean            @default(false)
  titularAtivoAnterior        Boolean            @default(true)
  /// AGENDADA | ATIVA | ENCERRADA | CANCELADA
  status                      String             @default("AGENDADA")
  appliedAt                   DateTime?
  endedAt                     DateTime?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  gerencia   Gerencia    @relation(fields: [gerenciaId], references: [id], onDelete: Cascade)
  titular    Funcionario @relation("SubstituicaoTitular", fields: [titularId], references: [id], onDelete: Cascade)
  substituto Funcionario @relation("SubstituicaoSubstituto", fields: [substitutoId], references: [id], onDelete: Cascade)

  @@index([status, dataInicio, dataFim])
  @@index([titularId, status])
  @@index([substitutoId, status])
}

model ProvedorInternet {
  id          String   @id @default(cuid())
  nome        String
  ip          String
  isPrincipal Boolean  @default(false)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model SubredeConfigurada {
  id        String   @id @default(cuid())
  cidr      String
  descricao String?
  createdAt DateTime @default(now())
}

model AreaViagem {
  id         String   @id @default(cuid())
  nome       String
  descricao  String?
  lat        Float
  lng        Float
  raioMetros Int      @default(500)
  ativa      Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model RequerimentoEndereco {
  id            String      @id @default(cuid())
  funcionarioId String      @unique
  status        String      @default("PENDENTE") // PENDENTE | RESPONDIDO
  respondidoEm  DateTime?
  criadoEm      DateTime    @default(now())
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
}

/// Permissão de um funcionário do RH (Perfis do RH): aba ("auditoria.registros") ou função
/// ("auditoria.funcionarios.corrigir-ponto"). Linha existente = liberado; sem linha = sem acesso.
/// Catálogo em backend/src/utils/recursos-rh.ts.
model PermissaoRh {
  id             String      @id @default(cuid())
  funcionarioId  String
  recurso        String
  concedidoPorId String?
  concedidoEm    DateTime    @default(now())
  funcionario    Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, recurso])
}

/// Tipos de requerimento de cadastro que o RH pede ao próprio funcionário preencher
/// (além do endereço, que tem modelo próprio).
enum TipoRequerimentoCadastro {
  DEPENDENTES
  FORMACAO_ACADEMICA
  CAPACITACOES
}

/// Requerimento de cadastro por tipo — mesmo fluxo do RequerimentoEndereco: o RH solicita
/// (individual ou para todos), o funcionário responde em "Minhas Requisições".
model RequerimentoCadastro {
  id            String                   @id @default(cuid())
  funcionarioId String
  tipo          TipoRequerimentoCadastro
  status        String                   @default("PENDENTE") // PENDENTE | RESPONDIDO
  criadoEm      DateTime                 @default(now())
  respondidoEm  DateTime?
  funcionario   Funcionario              @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, tipo])
}

model EnderecoResidencial {
  id            String      @id @default(cuid())
  funcionarioId String      @unique
  cep           String?
  logradouro    String?
  numero        String?
  complemento   String?
  bairro        String?
  cidade        String?
  uf            String?
  lat           Float?
  lng           Float?
  raioMetros    Int         @default(20)
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  updatedAt     DateTime    @updatedAt
}

model JornadaPeriodo {
  id                     String            @id @default(cuid())
  nome                   String
  descricao              String?
  ePadrao                Boolean           @default(false)
  ativo                  Boolean           @default(true)
  horaEntrada            String            @default("08:00")
  horaSaida              String            @default("17:00")
  jornadaDiariaMin       Int               @default(480)
  jornadaSemanalMin      Int               @default(2400)
  diasUteis              String            @default("[false,true,true,true,true,true,false]")
  tipoFlexibilidade      TipoFlexibilidade @default(FIXO)
  toleranciaEntradaMin   Int               @default(5)
  toleranciaSaidaMin     Int               @default(5)
  toleranciaHoraExtraMin Int               @default(10)
  toleranciaCalculoMin   Int               @default(0)
  almocoPodeIniciarA     String            @default("11:30")
  almocoPodeIniciarAte   String            @default("13:00")
  almocoMinMin           Int               @default(60)
  almocoMaxMin           Int               @default(90)
  bancoHorasLimiteMin    Int               @default(120)
  bancoHorasVigenciaDias Int               @default(30)
  horaExtraLimiteAuto    Int               @default(120)
  /// Jornada para estagiários/jovens aprendizes: sem almoço, banco de horas e hora extra.
  paraEstagiarios        Boolean           @default(false)
  funcionarios           Funcionario[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model Funcionario {
  id                                 String                           @id @default(cuid())
  userId                             String                           @unique
  matricula                          String?                          @unique // nullable: usuários AD sincronizados podem não ter matrícula
  cpf                                String?
  cargo                              String                           @default("")
  /// Nível do cargo (só empregado/concursado): Médio ou Superior.
  nivelCargo                         NivelCargo?
  departamento                       String?
  gerenciaId                         String?
  jornadaPeriodoId                   String?
  jornadaPeriodoDesde                DateTime?                        @db.Date
  jornadaPeriodoAssociadoEm          DateTime?
  modoHomeOffice                     Boolean                          @default(false)
  modoHibridoLocal                   Boolean                          @default(false)
  categoria                          CategoriaFuncional               @default(CONCURSADO)
  /// A partir desta data o funcionário passa a ter obrigação de ponto (ex.: assessor → concursado).
  /// Dias anteriores e efeitos de solicitações informativas não entram no cálculo.
  pontoObrigatorioDesde              DateTime?                        @db.Date
  ativo                              Boolean                          @default(true)
  /// Marcado pelo RH quando os campos manuais do cadastro (cargo, categoria, gerência etc.)
  /// já foram revisados/preenchidos após a sincronização automática com o AD.
  camposManuaisConfigurados          Boolean                          @default(false)
  jornadaHorasDia                    Int                              @default(8)
  extensionsId                       String?                          @unique // id na API externa de ramais
  section                            String? // seção (slug) na API externa
  subsecao                           String? // subseção (slug), quando aplicável
  isManager                          Boolean                          @default(false) // gerente da seção
  /// Supervisor de estágio (ESTAGIARIO / MENOR_APRENDIZ) — aprova solicitações no lugar do gerente
  supervisorEstagioId                String?
  supervisorEstagio                  Funcionario?                     @relation("SupervisorEstagio", fields: [supervisorEstagioId], references: [id], onDelete: SetNull)
  supervisionadosEstagio             Funcionario[]                    @relation("SupervisorEstagio")
  ramal                              String? // ramal telefônico
  sala                               String? // sala/room
  andar                              String? // andar/floor
  user                               User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  gerencia                           Gerencia?                        @relation(fields: [gerenciaId], references: [id], onDelete: SetNull)
  jornadaPeriodo                     JornadaPeriodo?                  @relation(fields: [jornadaPeriodoId], references: [id], onDelete: SetNull)
  registros                          RegistroPonto[]
  periodos                           PeriodoPonto[]
  afastamentos                       Afastamento[]
  solicitacoes                       Solicitacao[]
  documentosRh                       DocumentoRhEnvio[]
  requisicoes                        RequisicaoRhDestinatario[]
  jornadas                           JornadaTrabalho[]
  enderecoResidencial                EnderecoResidencial?
  requerimentoEndereco               RequerimentoEndereco?
  requerimentosCadastro              RequerimentoCadastro[]
  permissoesRh                       PermissaoRh[]
  modalidadeHistorico                FuncionarioModalidadeHistorico[]
  bancoHorasLiberacoes               BancoHorasLiberacao[]
  /// Tolerância individual do fechamento do banco (dias após a data-marco); null = usa a global.
  bancoHorasToleranciaFechamentoDias Int?
  fotoPerfilUrl                      String?
  solicitarAtualizacaoFoto           Boolean                          @default(false)
  dataNascimento                     DateTime?                        @db.Date
  dataAdmissao                       DateTime?                        @db.Date
  /// Data de desligamento — fonte de verdade da inatividade: preenchida (hoje ou passado)
  /// desativa o funcionário na hora; preenchida no futuro é aplicada por cron diário
  /// (ver GestaoService.cronDesligamentos). Reativar (ativo=true) limpa este campo.
  dataDesligamento                   DateTime?                        @db.Date

  // ── Dados pessoais (RH) ──────────────────────────────────────────────
  rg             String?
  rgOrgaoEmissor String?
  rgUf           String?
  rgDataEmissao  DateTime?    @db.Date
  raca           String?
  genero         String?
  emailPessoal   String?
  telefone       String?
  dependentes    Dependente[]

  // ── Jornada / características (RH) ───────────────────────────────────
  atividade                AtividadeTipo?
  /// "É fiscal?" — mesma mecânica de isManager: quando true, isenta automaticamente
  /// de registro de ponto (ver utils/categoria-jornada.ts, funcionarioSemRegistroPonto).
  isFiscal                 Boolean        @default(false)
  valeTransporte           Boolean        @default(false)
  /// Override manual de "Registro de ponto" (select, mesmo padrão de UX da Jornada).
  /// null = usa a sugestão automática (categoria/isManager/isFiscal); preenchido = override do RH.
  registroPontoObrigatorio Boolean?

  // ── Cargo e Lotação (Fase 1: valor atual; Fase 2: histórico versionado) ─
  cargoData      DateTime? @db.Date
  lotacaoInicio  DateTime? @db.Date
  lotacaoTermino DateTime? @db.Date

  // ── Capacitação (RH) — 1:N, ver models FormacaoAcademica / Capacitacao ─
  formacoesAcademicas FormacaoAcademica[]
  capacitacoes        Capacitacao[]

  // ── Específicos de Estágio / Jovem Aprendiz ──────────────────────────
  bolsaAuxilio    Decimal?
  curso           String?
  contratoInicio  DateTime? @db.Date
  contratoTermino DateTime? @db.Date
  cargaHoraria    String?
  diasSemana      String?

  /// Observações livres do RH sobre o funcionário (seção Geral do cadastro).
  observacoes String?

  // ── Cessão de Empregado (só CONCURSADO) ──────────────────────────────
  /// Marcação explícita de cessão — base para estatísticas/gráficos de cedidos.
  /// Os campos cessao* abaixo são cache do período vigente de FuncionarioCessaoHistorico.
  cedido             Boolean   @default(false)
  cessaoInicio       DateTime? @db.Date
  cessaoFim          DateTime? @db.Date
  cessaoOrgaoOrigem  String?
  cessaoOrgaoDestino String?

  createdAt                   DateTime                        @default(now())
  substituicoesComoTitular    GerenteSubstituicao[]           @relation("SubstituicaoTitular")
  substituicoesComoSubstituto GerenteSubstituicao[]           @relation("SubstituicaoSubstituto")
  categoriasHistorico         FuncionarioCategoriaHistorico[]
  lotacaoHistorico            FuncionarioLotacaoHistorico[]
  cessoesHistorico            FuncionarioCessaoHistorico[]
  assinaturasCicloBancoHoras  AssinaturaCicloBancoHoras[]
  FechamentoSituacao          FechamentoSituacao[]
  ExameOcupacional            ExameOcupacional[]
}

/// Dependentes (filhos) do funcionário — lista estruturada (N por funcionário).
model Dependente {
  id             String      @id @default(cuid())
  funcionarioId  String
  nome           String
  cpf            String?
  dataNascimento DateTime?   @db.Date
  funcionario    Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())

  @@index([funcionarioId])
}

/// Formação acadêmica (1:N) — o funcionário pode ter várias, cada uma com seu próprio
/// grau (Ensino Médio, Superior, Pós etc.), curso, instituição e conclusão.
model FormacaoAcademica {
  id               String      @id @default(cuid())
  funcionarioId    String
  grauEscolaridade String?
  curso            String
  instituicao      String?
  conclusao        DateTime?   @db.Date
  funcionario      Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now())

  @@index([funcionarioId])
}

/// Cursos/capacitações (1:N) — treinamentos livres, distintos de formação acadêmica.
model Capacitacao {
  id            String      @id @default(cuid())
  funcionarioId String
  nome          String
  instituicao   String?
  conclusao     DateTime?   @db.Date
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([funcionarioId])
}

/// Histórico versionado de Cargo/Lotação/Setor/Situação (Fase 2) — cada linha é uma
/// "movimentação" (promoção, transferência, mudança de setor) vigente num período.
/// Os campos "atuais" em Funcionario (cargo, gerenciaId, subsecao, cargoData,
/// lotacaoInicio, lotacaoTermino) seguem sendo um cache denormalizado da vigência
/// aberta mais recente — mesmo padrão já usado para FuncionarioCategoriaHistorico.
model FuncionarioLotacaoHistorico {
  id            String      @id @default(cuid())
  funcionarioId String
  cargo         String
  gerenciaId    String?
  subsecao      String?
  situacaoAtiva Boolean     @default(true)
  /// Data do ato/portaria que originou a movimentação (pode diferir da vigência).
  data          DateTime?   @db.Date
  vigenciaDesde DateTime    @db.Date
  /// null = vigência atual (aberta)
  vigenciaAte   DateTime?   @db.Date
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  gerencia      Gerencia?   @relation(fields: [gerenciaId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([funcionarioId, vigenciaDesde])
}

/// Períodos de cessão do Empregado (histórico). Sem sobreposição entre períodos;
/// o período que cobre hoje (ou o mais recente) é copiado para Funcionario.cessao*.
model FuncionarioCessaoHistorico {
  id            String      @id @default(cuid())
  funcionarioId String
  inicio        DateTime    @db.Date
  /// null = cessão em aberto (sem data de término definida)
  fim           DateTime?   @db.Date
  orgaoOrigem   String
  orgaoDestino  String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([funcionarioId, inicio])
}

/// Vigência de categoria funcional — base para isentar períodos sem obrigação de ponto
/// (ex.: concursado → assessor → concursado: só os trechos como concursado entram no cálculo).
/// Fechamento do banco de horas quando a obrigação de ponto muda (virou chefe/fiscal/assessor ou voltou a bater).
model FechamentoSituacao {
  id              String      @id @default(cuid())
  funcionarioId   String
  /// Dia da mudança (Brasília).
  dataMudanca     DateTime    @db.Date
  deRotulo        String
  paraRotulo      String
  deSemRegistro   Boolean
  paraSemRegistro Boolean
  /// Saldo do banco de horas (min) no momento da mudança.
  saldoMinutos    Int
  cicloInicio     String?
  alteradoPorNome String?
  createdAt       DateTime    @default(now())
  funcionario     Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId, dataMudanca])
}

model FuncionarioCategoriaHistorico {
  id                       String             @id @default(cuid())
  funcionarioId            String
  categoria                CategoriaFuncional
  /// Era chefe (isManager) durante esta vigência — antes existia a categoria própria
  /// GERENTE; agora "ser chefe" é uma característica, então a vigência guarda a
  /// categoria real + esta flag, preservando o cálculo histórico de isenção de ponto.
  isManager                Boolean            @default(false)
  /// Era fiscal e/ou tinha o override "registro de ponto" do RH durante esta vigência.
  isFiscal                 Boolean            @default(false)
  registroPontoObrigatorio Boolean?
  vigenciaDesde            DateTime           @db.Date
  /// null = vigência atual (aberta)
  vigenciaAte              DateTime?          @db.Date
  funcionario              Funcionario        @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  createdAt                DateTime           @default(now())

  @@index([funcionarioId, vigenciaDesde])
}

model JornadaTrabalho {
  id               String      @id @default(cuid())
  funcionarioId    String
  diaSemana        Int // 0=Dom, 1=Seg ... 6=Sáb
  horaEntrada      String // "08:00"
  horaSaida        String // "17:00"
  horaInicioInterv String // "12:00"
  horaFimInterv    String // "13:00"
  funcionario      Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, diaSemana])
}

model RegistroPonto {
  id                String       @id @default(cuid())
  funcionarioId     String
  tipo              TipoPonto
  dataHora          DateTime
  latitude          Float?
  longitude         Float?
  origem            OrigemPonto  @default(WEB)
  modoRegistro      ModoRegistro @default(DESKTOP)
  ipOrigem          String?
  fotoUrl           String?
  dentroPerimetro   Boolean      @default(false)
  observacao        String?
  observacoes       Json         @default("[]")
  ajustado          Boolean      @default(false)
  ajustadoPor       String?
  /// Gerado por solicitação de assessor/gerente — aparece no histórico, não entra em cálculo.
  apenasInformativo Boolean      @default(false)
  funcionario       Funcionario  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())

  @@index([funcionarioId, dataHora])
}

model PeriodoPonto {
  id                      String            @id @default(cuid())
  funcionarioId           String
  mes                     Int // 1–12
  ano                     Int
  horasTrabalhadasMinutos Int               @default(0)
  horasExtrasMinutos      Int               @default(0)
  horasFaltaMinutos       Int               @default(0)
  diasTrabalhados         Int               @default(0)
  status                  StatusPeriodo     @default(ABERTO)
  fechadoEm               DateTime?
  aprovadoPor             String?
  funcionario             Funcionario       @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  assinatura              AssinaturaQuadro?

  @@unique([funcionarioId, mes, ano])
}

model AssinaturaQuadro {
  id                           String           @id @default(cuid())
  periodoId                    String           @unique
  periodo                      PeriodoPonto     @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  status                       StatusAssinatura @default(PENDENTE_FUNCIONARIO)
  bancoHorasSaldoTotalMinutos  Int              @default(0)
  // Assinatura do funcionário
  assinadoFuncionarioEm        DateTime?
  assinadoFuncionarioIp        String? // IP real do PC (primeiro salto do X-Forwarded-For)
  assinadoFuncionarioIpGateway String? // IP da gateway de borda (peer imediato / último proxy)
  assinadoFuncionarioUserAgent String?
  assinadoFuncionarioUserId    String?
  // Assinatura do gestor
  assinadoGestorEm             DateTime?
  assinadoGestorIp             String? // IP real do PC (primeiro salto do X-Forwarded-For)
  assinadoGestorIpGateway      String? // IP da gateway de borda (peer imediato / último proxy)
  assinadoGestorUserAgent      String?
  assinadoGestorUserId         String?
  assinadoGestorNome           String?
  criadoEm                     DateTime         @default(now())
  criadoPor                    String           @default("SISTEMA")
  // PDF final imutável (gerado uma vez ao concluir; selado com ICP-Brasil quando houver certificado)
  pdfFinalUrl                  String?
  pdfFinalSha256               String?
  seladoEm                     DateTime?
  seloSerial                   String?
  /// Impressão digital dos DADOS do documento: só gera PDF novo quando ela muda
  pdfFingerprint               String?
  /// Versões anteriores emitidas: [{ sha256, geradoEm, substituidoEm }]
  pdfHistorico                 Json?

  @@index([status])
}

/// Assinatura do relatório do ciclo de banco de horas (somente funcionário; documento disponível ao RH).
model AssinaturaCicloBancoHoras {
  id                String      @id @default(cuid())
  funcionarioId     String
  funcionario       Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  inicioIso         String // YYYY-MM-DD
  fimIso            String // YYYY-MM-DD
  saldoCicloMinutos Int         @default(0)
  assinadoEm        DateTime
  assinadoIp        String?
  assinadoIpGateway String?
  assinadoUserAgent String?
  assinadoUserId    String?
  criadoEm          DateTime    @default(now())

  @@unique([funcionarioId, inicioIso, fimIso])
  @@index([funcionarioId])
}

/// Grupos do CID-10 oferecidos no atestado médico (gerenciados em Configurações → Solicitações).
model CidGrupo {
  id        String   @id @default(cuid())
  /// Ex.: J00-J99
  codigo    String   @unique
  descricao String
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Tipos de licença configuráveis (art. 473 da CLT e ACT): regras editadas pelo RH.
model TipoLicenca {
  id              String   @id @default(cuid())
  nome            String
  ativo           Boolean  @default(true)
  ordem           Int      @default(0)
  /// Categorias que podem pedir (vazio = todas).
  categorias      String[]
  /// LIMITE (até N) | FIXO (exatamente N) | LIVRE (pelo tempo necessário)
  modoDuracao     String   @default("LIMITE")
  /// 0 / null = sem limite.
  limiteDias      Int?
  prorrogacaoDias Int?
  /// CORRIDOS | UTEIS
  contagem        String   @default("CORRIDOS")
  consecutivos    Boolean  @default(true)
  /// DIAS | OCORRENCIAS
  unidade         String   @default("DIAS")
  janelaMeses     Int?
  limiteNaJanela  Int?
  permiteParcial  Boolean  @default(false)
  exigeDocumento  Boolean  @default(false)
  orientacao      String?
  /// AFASTAMENTO | REDUCAO_JORNADA
  efeito          String   @default("AFASTAMENTO")
  reducaoMaxPct   Int?
  /// Padrão do sistema (identifica o tipo para LICENCA_MATERNIDADE/PATERNIDADE).
  codigoSistema   String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Exame médico ocupacional PERIÓDICO (ASO). Enviado pelo funcionário ou lançado pelo RH; só vale
/// depois de confirmado. Dado de saúde (LGPD): visível ao RH autorizado e ao próprio funcionário.
model ExameOcupacional {
  id                       String      @id @default(cuid())
  funcionarioId            String
  dataRealizacao           DateTime    @db.Date
  /// AGUARDANDO_CONFERENCIA | CONFIRMADO | DEVOLVIDO
  situacao                 String      @default("AGUARDANDO_CONFERENCIA")
  /// APTO | INAPTO; registros antigos podem ter APTO_COM_RESTRICAO (preenchido na confirmação)
  resultado                String?
  medico                   String?
  clinica                  String?
  proximoVencimento        DateTime?   @db.Date
  /// Arquivo do ASO (guardado fora da pasta pública; baixado por rota autenticada).
  arquivoCaminho           String?
  nomeArquivo              String?
  mimeType                 String?
  /// RH | FUNCIONARIO
  origem                   String      @default("RH")
  requisicaoDestinatarioId String?
  motivoDevolucao          String?
  observacao               String?
  registradoPorNome        String?
  registradoPorUserId      String?
  conferidoPorNome         String?
  conferidoPorUserId       String?
  conferidoEm              DateTime?
  avisoAVencerEm           DateTime?
  avisoVencidoEm           DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  funcionario              Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId, dataRealizacao])
  @@index([situacao])
}

model Afastamento {
  id                String          @id @default(cuid())
  funcionarioId     String
  tipo              TipoAfastamento
  dataInicio        DateTime
  dataFim           DateTime
  /// HH:MM — presente junto com horarioFim = atestado/afastamento parcial (não dia inteiro)
  horarioInicio     String?
  /// HH:MM — presente junto com horarioInicio = afastamento parcial
  horarioFim        String?
  justificativa     String?
  documentoUrl      String?
  aprovadoPor       String?
  /// Gerado por solicitação de assessor/gerente — aparece no histórico, não entra em cálculo.
  apenasInformativo Boolean         @default(false)
  /// Solicitação que gerou o afastamento (remoção ao alterar/cancelar férias). Null = legado/manual.
  solicitacaoId     String?
  /// Nome do tipo de licença (ex.: "Licença Nojo") para exibição no histórico.
  rotulo            String?
  funcionario       Funcionario     @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@index([solicitacaoId])
}

model Solicitacao {
  id                   String            @id @default(cuid())
  funcionarioId        String
  tipo                 String // CORRECAO_PONTO | ATESTADO | FERIAS | LICENCA | ABONO | DAY_OFF | HORA_EXTRA | ENVIO_DOCUMENTO_RH
  dataReferencia       DateTime
  dataInicio           DateTime? // data inicial (ATESTADO, FERIAS, LICENCA, ABONO)
  dataFim              DateTime? // data final do intervalo
  descricao            String
  metadados            Json? // dados específicos por tipo (vide plano)
  status               StatusSolicitacao @default(PENDENTE)
  /// Assessor/Gerente: após aprovação, histórico é só informativo (não base de cálculo).
  apenasInformativo    Boolean           @default(false)
  // Etapa 1 — Gestor
  gestorUserId         String? // User.id do gestor que resolveu
  gestorObservacao     String?
  gestorResolvidoEm    DateTime?
  // Etapa 2 — RH
  rhUserId             String? // User.id do analista de RH que resolveu
  rhObservacao         String?
  rhResolvidoEm        DateTime?
  // Guia médica individual (ATESTADO com homologação) — enviada pelo RH ao funcionário
  guiaMedicoUrl        String?
  guiaMedicoEnviadaEm  DateTime?
  guiaMedicoObservacao String?
  // Documento de retorno da consulta (aptidão/inaptidão) — enviado pelo funcionário
  documentoRetornoUrl  String?
  documentoRetornoEm   DateTime?
  // Campos legados mantidos para compatibilidade
  observacaoGestor     String?
  resolvidoPor         String? // Keycloak sub (aponta para RH no novo fluxo)
  resolvidoEm          DateTime?
  funcionario          Funcionario       @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  createdAt            DateTime          @default(now())
}

model DocumentoRhEnvio {
  id            String      @id @default(cuid())
  funcionarioId String
  descricao     String
  arquivoUrl    String
  nomeArquivo   String?
  mimeType      String?
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([funcionarioId, createdAt])
}

model ConfiguracaoSolicitacoes {
  id                          String   @id @default("singleton")
  // Regras de Atestado
  atestadoDiasLimiteSimples   Int      @default(3)
  atestadoDiasLimiteInss      Int      @default(14)
  atestadoPrazoEnvioDias      Int      @default(2)
  atestadoTempoRetornoMin     Int      @default(60)
  /// Tolerância de deslocamento na ida (saída do trabalho → início do atestado parcial).
  atestadoTempoIdaMin         Int      @default(60)
  atestadoMensagemOriginais   String   @default("Os originais devem ser entregues ao setor de RH.")
  // Regras de Férias
  feriasAntecedenciaMinDias   Int      @default(30)
  feriasMinimoGrandePeriodo   Int      @default(14)
  feriasMinimoOutrosPeriodos  Int      @default(5)
  feriasMaxPeriodos           Int      @default(3)
  feriasMaxDiasVenda          Int      @default(10)
  feriasVedacaoPreFeriadoDias Int      @default(1)
  /// Férias parceladas: dias antes do início do 2º/3º período para avisar o RH a enviar Aviso e Recibo.
  feriasRodadaAvisoDias       Int      @default(45)
  // Tipos de solicitação ativos no portal do funcionário
  tipoAtivoCorrecaoPonto      Boolean  @default(true)
  tipoAtivoAtestado           Boolean  @default(true)
  tipoAtivoFerias             Boolean  @default(true)
  tipoAtivoLicenca            Boolean  @default(true)
  tipoAtivoAbono              Boolean  @default(true)
  tipoAtivoDayOff             Boolean  @default(true)
  tipoAtivoHoraExtra          Boolean  @default(true)
  tipoAtivoEnvioDocumentoRh   Boolean  @default(true)
  /// Abono livre: ligado = funcionário pede abono sem depender do tempo liberado pelo RH (que, se houver, é usado primeiro);
  /// desligado = só pede abono com tempo liberado pelo RH, dentro do limite.
  abonoAlemLimiteLiberadoRh   Boolean  @default(true)
  /// Acordo coletivo: dias de abono diário por funcionário a cada dois ciclos cheios do banco de horas (0 = desativado).
  abonoCotaDiasDoisCiclos     Int      @default(0)
  /// Grupo do CID no atestado: OBRIGATORIO | OPCIONAL | DESATIVADO.
  atestadoCidModo             String   @default("OBRIGATORIO")
  updatedAt                   DateTime @updatedAt
  createdAt                   DateTime @default(now())
}

model FeriadoConfig {
  id               String   @id @default(cuid())
  data             DateTime @db.Date
  nome             String
  tipo             String // "NACIONAL" | "DISTRITAL" | "FACULTATIVO" | "MANUAL" | "ABONO" (abono do RH — não é feriado)
  bloqueiaRegistro Boolean  @default(true)
  origem           String // "API" | "MANUAL"
  observacao       String?
  marcoHorario     String? // "HH:MM" — ausente = dia todo
  marcoLado        String? // "ANTES" | "DEPOIS"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([data])
}

model SyncLog {
  id        String   @id @default(cuid())
  source    String // "extensions"
  status    String // "success" | "error"
  created   Int      @default(0)
  updated   Int      @default(0)
  skipped   Int      @default(0)
  errors    Int      @default(0)
  details   Json?
  createdAt DateTime @default(now())
}

// Configuração SMTP — singleton, acesso restrito a super admin
model ConfiguracaoEmail {
  id             String   @id @default("singleton")
  provedor       String   @default("LOCAWEB") // "LOCAWEB" | "MICROSOFT"
  host           String?
  porta          Int?     @default(587)
  seguranca      String   @default("STARTTLS") // "NONE" | "SSL" | "STARTTLS"
  usuario        String?
  senha          String?
  nomeRemetente  String?
  emailRemetente String?
  ativo          Boolean  @default(false)
  atualizadoEm   DateTime @updatedAt
  criadoEm       DateTime @default(now())
}

// Configuração de notificação por evento — uma linha por gatilho
model ConfiguracaoNotificacao {
  id           String   @id // ex: "ASSINAR_QUADRO", "FERIAS_OBRIGATORIO"
  ativoEmail   Boolean  @default(false)
  ativoSistema Boolean  @default(false)
  atualizadoEm DateTime @updatedAt
  criadoEm     DateTime @default(now())
}

enum TipoRequisicaoRh {
  PERIODICO
  EXAME_MEDICO
  FERIAS
  ASSINATURA_DOCUMENTOS
  OUTRO
}

enum StatusRequisicaoDestinatario {
  PENDENTE
  VISUALIZADO
  RESPONDIDO
}

model RequisicaoRh {
  id            String                     @id @default(cuid())
  tipo          TipoRequisicaoRh
  titulo        String
  descricao     String?
  arquivoUrl    String?
  prazo         DateTime?
  ativa         Boolean                    @default(true)
  criadoPorId   String
  criadoPor     User                       @relation("RequisicaoRhCriador", fields: [criadoPorId], references: [id])
  destinatarios RequisicaoRhDestinatario[]
  criadaEm      DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
}

model RequisicaoRhDestinatario {
  id                   String                       @id @default(cuid())
  requisicaoId         String
  funcionarioId        String
  requisicao           RequisicaoRh                 @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  funcionario          Funcionario                  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  status               StatusRequisicaoDestinatario @default(PENDENTE)
  visualizadaEm        DateTime?
  respondidaEm         DateTime?
  respostaTexto        String?
  respostaArquivoUrl   String?
  arquivoIndividualUrl String?
  createdAt            DateTime                     @default(now())

  @@unique([requisicaoId, funcionarioId])
}

// Notificações individuais por usuário (bell icon / página de notificações)
model Notificacao {
  id             String   @id @default(cuid())
  userExternalId String // Keycloak sub = User.externalId
  titulo         String
  corpo          String?
  tipo           String? // event id: "ASSINAR_QUADRO", "FERIAS_OBRIGATORIO" etc.
  lida           Boolean  @default(false)
  criadoEm       DateTime @default(now())

  @@index([userExternalId, lida])
  @@index([userExternalId, criadoEm(sort: Desc)])
}

/// Modalidade de trabalho (presencial / home office / híbrido) com vigência: a modalidade vale
/// do dia `desde` em diante, sem alterar os dias anteriores (cálculos de hora extra e afins).
model FuncionarioModalidadeHistorico {
  id            String      @id @default(cuid())
  funcionarioId String
  /// Primeiro dia (civil, Brasília) em que esta modalidade vale.
  desde         DateTime    @db.Date
  homeOffice    Boolean     @default(false)
  hibrido       Boolean     @default(false)
  createdAt     DateTime    @default(now())
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, desde])
  @@index([funcionarioId])
}

/// Contador único do NSR (Número Sequencial de Registro) do REP — sem lacunas: incrementado
/// com bloqueio de linha na MESMA transação que grava a marcação/evento.
model ContadorNsr {
  id     String @id @default("singleton")
  ultimo Int    @default(0)
}

/// Livro de marcações do REP (base do AFD) — SOMENTE INCLUSÃO (trigger bloqueia UPDATE/DELETE).
/// Correções ficam no registroPonto (tratamento/PTRP) e aparecem no AEJ; aqui fica o original.
model MarcacaoRep {
  id               String    @id @default(cuid())
  nsr              Int       @unique
  funcionarioId    String
  cpf              String
  tipoPonto        TipoPonto
  dataHoraMarcacao DateTime
  dataHoraGravacao DateTime
  /// 01 mobile · 02 navegador · 03 desktop · 04 dispositivo · 05 outro
  coletor          String
  offline          Boolean   @default(false)
  registroPontoId  String?
  instanciaId      String?
  hashAnterior     String?
  hash             String
  /// Reconstituída na carga inicial (meses anteriores ao livro).
  reconstituida    Boolean   @default(false)
  /// Fuso horário da marcação e da gravação (Anexo IX, item 6.5), ex.: "-0300".
  fusoMarcacao     String    @default("-0300")
  fusoGravacao     String    @default("-0300")
  createdAt        DateTime  @default(now())

  @@index([funcionarioId, dataHoraMarcacao])
  @@index([dataHoraMarcacao])
}

/// Início de operação de cada tipo de REP (REP-A / REP-P) — SOMENTE INCLUSÃO. A virada para REP-P é irreversível.
model VigenciaRep {
  id             String   @id @default(cuid())
  tipo           String
  inicio         DateTime
  registroInpiId String?
  numeroRegistro String?
  criadoPorId    String?
  criadoPorNome  String?
  createdAt      DateTime @default(now())

  @@index([tipo, inicio])
}

/// Registro do programa no INPI (art. 91) — checklist das etapas e certificado, com histórico por versão.
model RegistroProgramaInpi {
  id                 String   @id @default(cuid())
  versao             String
  /// Etapas: { chave: { feito: boolean, data?: string, responsavel?: string, obs?: string } }
  etapas             Json     @default("{}")
  hashCodigoFonte    String?
  protocoloNumero    String?
  certificadoNumero  String?
  certificadoData    String?
  certificadoPdfNome String?
  certificadoPdfSha  String?
  certificadoPdf     Bytes?
  status             String   @default("EM_ANDAMENTO")
  criadoPorNome      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Documentação técnica: autoria do desenvolvimento (uma linha) e tabela de revisões/versões.
model DocumentacaoAutoria {
  id                 String   @id @default("singleton")
  autor              String
  /// AAAA-MM-DD
  dataEntrega        String
  local              String
  gerenteResponsavel String
  solicitacao        String
  versaoAtual        String   @default("1.0.0")
  atualizadoPorNome  String?
  updatedAt          DateTime @updatedAt
}

model DocumentacaoRevisao {
  id             String    @id @default(cuid())
  /// Versão da documentação (semver) após esta revisão.
  versao         String
  /// MANUAL | AUTOMATICA
  tipo           String    @default("MANUAL")
  desenvolvedor  String
  revisor        String?
  /// AAAA-MM-DD
  dataRevisao    String
  comentario     String
  local          String?
  equipe         String?
  secoesAfetadas String?
  /// Impressão digital do conteúdo gerado (revisões automáticas).
  hashConteudo   String?
  anuladaEm      DateTime?
  motivoAnulacao String?
  anuladaPorNome String?
  criadoPorNome  String?
  createdAt      DateTime  @default(now())

  @@index([createdAt])
}

/// Termos de Uso do sistema — uma linha por versão; publicar não apaga nem altera as anteriores.
model TermoUso {
  id               String           @id @default(cuid())
  versao           Int              @unique
  titulo           String
  conteudo         String
  resumoAlteracoes String?
  /// RASCUNHO | PUBLICADO | SUBSTITUIDO (só uma versão PUBLICADO por vez)
  status           String           @default("RASCUNHO")
  versaoAnteriorId String?
  sha256           String?
  criadoPorNome    String?
  publicadoPorNome String?
  publicadoEm      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  aceites          AceiteTermoUso[]

  @@index([status])
}

/// Aceite dos Termos de Uso — SOMENTE INCLUSÃO (gatilho no banco). Um aceite por usuário e versão.
model AceiteTermoUso {
  id            String   @id @default(cuid())
  termoId       String
  termo         TermoUso @relation(fields: [termoId], references: [id], onDelete: Restrict)
  userId        String
  funcionarioId String?
  nome          String
  matricula     String?
  aceitoEm      DateTime @default(now())
  ip            String
  ipGateway     String?
  userAgent     String?
  /// SHA-256 do texto aceito (prova de qual conteúdo foi aceito).
  sha256Termo   String
  /// Código do aceite (SHA-256 dos dados do aceite, agrupado).
  codigo        String

  @@unique([termoId, userId])
  @@index([userId])
}

/// Registro de documentos assinados pelo sistema (ciclo de banco de horas, ciência de atestado,
/// documentos de férias assinados…) pela impressão digital do arquivo: valida qualquer upload.
model DocumentoEmitido {
  id           String   @id @default(cuid())
  tipo         String
  referenciaId String
  sha256       String   @unique
  titulo       String
  /// Dados mínimos exibidos na verificação pública (sem dados pessoais completos).
  detalhes     Json     @default("{}")
  emitidoEm    DateTime @default(now())

  @@index([tipo, referenciaId])
}

/// Impressão digital (SHA-256) de cada PDF de comprovante emitido — verifica se um arquivo é o original.
model ComprovanteEmitido {
  id        String   @id @default(cuid())
  nsr       Int
  sha256    String   @unique
  emitidoEm DateTime @default(now())

  @@index([nsr])
}

/// Eventos do REP (AFD tipos 2, 4, 5 e 6) — SOMENTE INCLUSÃO.
model EventoRep {
  id          String   @id @default(cuid())
  nsr         Int      @unique
  tipo        Int
  dataHora    DateTime
  dados       Json
  instanciaId String?
  createdAt   DateTime @default(now())

  @@index([tipo, dataHora])
}

/// Instância (máquina virtual/servidor) que roda o REP — detectada automaticamente a cada início.
model InstanciaRep {
  id               String    @id @default(cuid())
  codigo           String    @unique
  impressaoDigital String
  origem           Json
  hostname         String?
  primeiraVez      DateTime  @default(now())
  ultimaVez        DateTime  @default(now())
  ativa            Boolean   @default(true)
  encerradaEm      DateTime?
}

/// Extrações de AFD/AEJ (comprovação de entrega ao Auditor-Fiscal e controle do maior NSR exportado).
model ExtracaoArquivoFiscal {
  id             String   @id @default(cuid())
  tipo           String
  oficial        Boolean
  escopo         String
  funcionarioIds Json
  periodoInicio  String
  periodoFim     String
  nomeArquivo    String
  sha256         String
  assinado       Boolean
  nsrMaximo      Int?
  registros      Int
  geradoPorId    String?
  geradoPorNome  String?
  createdAt      DateTime @default(now())
}

/// Retrato das partes geradas da documentação técnica (rotas, tabelas, dependências, rotinas, seções).
/// Serve para detectar mudanças e gerar a revisão automática com o resumo da diferença.
model DocumentacaoSnapshot {
  id        String   @id @default(cuid())
  hash      String
  conteudo  Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}
