[Unit]
Description=Limpeza segura de lixo Docker (não afeta containers em execução nem volumes)
Documentation=file:///usr/local/sbin/docker-prune-safe.sh
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/docker-prune-safe.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
# stdout/stderr vão para o journal: journalctl -u docker-prune-safe.service
